---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import afShieldImg from '../assets/brand/AF 2.webp';
---

<Layout
  title="Astillero Fuentes"
  hideNavbar={true}
  hideFooter={true}
  noScroll={true}
>
  <div class="splash fixed inset-0 bg-[#1b1936] flex flex-col items-center justify-center gap-10">

    <!-- Shield -->
    <div class="logo-wrap opacity-0">
      <Image
        src={afShieldImg}
        alt="Astillero Fuentes"
        width={90}
        format="webp"
        quality={85}
        loading="eager"
        decoding="sync"
        class="invert"
      />
    </div>

    <!-- Brand name -->
    <span class="brand-name opacity-0 text-white italic tracking-wide text-2xl" style="font-family: 'Rogue Sans Nova Extended', sans-serif; font-weight: 400;">
      Astillero Fuentes
    </span>

    <!-- Loading bar -->
    <div class="bar-track w-32 h-px bg-white/10 overflow-hidden">
      <div class="bar-fill h-full bg-white/60 w-0"></div>
    </div>

  </div>
</Layout>

<style>
  .logo-wrap {
    transition: opacity 0.6s ease;
  }
  .brand-name {
    transition: opacity 0.6s ease 0.2s;
  }
  .bar-fill {
    transition: width 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .splash {
    transition: opacity 0.4s ease;
  }
</style>

<script>
  const logoWrap = document.querySelector('.logo-wrap') as HTMLElement;
  const brandName = document.querySelector('.brand-name') as HTMLElement;
  const barFill = document.querySelector('.bar-fill') as HTMLElement;
  const splash = document.querySelector('.splash') as HTMLElement;

  // Fade in elements
  requestAnimationFrame(() => {
    logoWrap.style.opacity = '1';
    brandName.style.opacity = '1';

    setTimeout(() => {
      barFill.style.width = '100%';
    }, 100);

    // Fade out splash then redirect
    setTimeout(() => {
      splash.style.opacity = '0';
      setTimeout(() => {
        window.location.replace('/classer');
      }, 400);
    }, 1800);
  });
</script>
